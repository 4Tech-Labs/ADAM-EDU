# ================================================================
# ADAM v8 - Environment Variables
# Copy this file to .env and fill in the real values.
# DO NOT COMMIT .env - it is in .gitignore.
# Production secrets go in Google Secret Manager, not here.
# ================================================================

# -- LLM ----------------------------------------------------------
GEMINI_API_KEY=

# -- OpenRouter (proveedor alterno, OPCIONAL) ---------------------
# Solo se usa si NODE_MODEL_OVERRIDES enruta un nodo a un model id con "/" (p.ej.
# "minimax/minimax-m3"). Si está vacío y un nodo se enruta a OpenRouter, _build_llm
# DEGRADA limpio a Gemini (no rompe). El fallback cross-provider sigue siendo Gemini,
# así que GEMINI_API_KEY también es obligatorio en ese caso.
OPENROUTER_API_KEY=
# Atribución opcional en el dashboard de OpenRouter (no son secretos):
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=
# Tuning opcional (defaults entre paréntesis):
#   OPENROUTER_REASONING_MAX_TOKENS (4000) — presupuesto de reasoning tokens (si NO usas effort).
#   OPENROUTER_REASONING_EFFORT ("")        — nivel de razonamiento: max|xhigh|high|medium|low|minimal|none.
#                                             EXCLUYENTE con el presupuesto de arriba (400 si mandas ambos). Con effort,
#                                             OpenRouter toma una fracción del max_tokens total para razonar (~80% en
#                                             "high") y deja el resto a la respuesta; con effort alto, sube el presupuesto.
#   OPENROUTER_TIMEOUT_SECONDS (150)        — timeout por request antes de caer a Gemini.
#   OPENROUTER_REQUESTS_PER_SECOND (5)      — rate limiter dedicado (separado del de Gemini).
#   OPENROUTER_MAX_BUCKET_SIZE (10)         — burst del rate limiter de OpenRouter.
#   OPENROUTER_PROVIDER_ORDER ("")          — upstreams capaces, coma-separados (p.ej. "Together,Parasail,Morph").
#   OPENROUTER_REQUIRE_PARAMETERS (true)    — solo proveedores que soportan los params (structured-output). "false" relaja.
#   OPENROUTER_DATA_COLLECTION ("")         — política de datos del routing. VACÍO = no se envía (routing normal).
#                                             "deny" restringe a proveedores no-recolección (NO es zero-retention;
#                                             ZDR es a nivel de cuenta). Úsalo solo si verificaste que tu modelo lo soporta.
OPENROUTER_REASONING_MAX_TOKENS=
OPENROUTER_REASONING_EFFORT=
OPENROUTER_TIMEOUT_SECONDS=
OPENROUTER_PROVIDER_ORDER=
OPENROUTER_REQUIRE_PARAMETERS=
OPENROUTER_DATA_COLLECTION=
# Activación por-nodo (JSON). Reversión instantánea = borrar la entrada del nodo.
# Sin override, todo corre en Gemini (byte-idéntico).
# Nodos que SÍ alcanzan OpenRouter con un id "/" (provider-aware, vía _build_llm): schema_designer,
# m3_content_generator, m3_questions_generator, m4_content_generator, m5_content_generator,
# m5_questions_generator.
# Los demás (case_architect, m3_notebook_generator, m3_notebook_generator_escalation) son Gemini-only:
# un id "/" ahí NO enruta a OpenRouter (el primary falla y cae al fallback Gemini) — no los pongas a un
# slug "/". (La escalación del notebook se deja en Gemini directo a propósito: con OPENROUTER_REASONING_EFFORT=high
# el razonamiento consume ~80% del max_tokens total y estrangularía la salida del notebook largo.)
# m4_content_generator vía google/gemini-3.1-pro-preview cuesta MÁS ($2/$12 vs $1.25/$10 directo) y razona
# al effort GLOBAL (no al medium por-tier); verifica finish_reason=stop (sin truncar) en un caso ml_ds real.
# Ejemplo (M5 + schema_designer + M3 content/questions a GLM, + M4 a Gemini 3.1 Pro vía OpenRouter):
# NODE_MODEL_OVERRIDES={"schema_designer":"z-ai/glm-5.2","m3_content_generator":"z-ai/glm-5.2","m3_questions_generator":"z-ai/glm-5.2","m5_content_generator":"z-ai/glm-5.2","m5_questions_generator":"z-ai/glm-5.2","m4_content_generator":"google/gemini-3.1-pro-preview"}

# -- LangSmith (optional, tracing) --------------------------------
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false

# -- PostgreSQL ---------------------------------------------------
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5434
DB_NAME=postgres

# DATABASE_URL - required by shared.database.Settings
# Defaults below match the repo root docker-compose.yml.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5434/postgres
# Production on Supabase/Supavisor must use the transaction pooler endpoint on port 6543.
# Example: postgresql+psycopg://postgres.<project_ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Keep ENVIRONMENT=production so shared.database selects NullPool for autoscaling workloads.

# -- Test database (pytest) ---------------------------------------
# The backend test suite NEVER uses the DATABASE_URL above. backend/tests/conftest.py
# points pytest at a dedicated `adam_test` database on the same local Postgres, so running
# tests can never wipe the users/profiles/courses you created in development.
# Override only if you need a different test target (a guard rejects anything but adam_test locally):
# TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5434/adam_test

# Optional stable password for `scripts/seed_dev.py` accounts (else one is generated + printed).
# SEED_DEV_PASSWORD=

# -- Connection Pooling -------------------------------------------
# Use DB_MAX_OVERFLOW=2 on Cloud Run (ephemeral instances).
# Use DB_MAX_OVERFLOW=10 locally or on persistent VMs.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
# Connection-level SQL timeouts (milliseconds).
# These are injected into every connection as Postgres runtime settings.
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000
# Fail-fast budget for critical DB endpoints (/api/auth/me, /progress, /authoring/jobs).
DB_CRITICAL_ENDPOINT_BUDGET=64
# Client retry hint (Retry-After header) for controlled 503 backpressure.
DB_RETRY_AFTER_SECONDS=3

# -- Deployment Environment ---------------------------------------
# development -> QueuePool (local); production -> NullPool (Supavisor tx mode).
# Job dispatch is governed separately by AUTHORING_DISPATCH (see Cloud Tasks section).
ENVIRONMENT=development
# Optional override used by the runtime launcher.
# If set, APP_ENV takes precedence over ENVIRONMENT.
APP_ENV=

# -- Runtime launcher profile (shared.app) ------------------------
# Launcher command: uv run python -m shared.app
# reload is enabled only when effective env is development.
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=2
APP_TIMEOUT_KEEP_ALIVE=30
APP_TIMEOUT_GRACEFUL_SHUTDOWN=60

# -- Authoring live preview (kill-switch) -------------------------
# When true (default), the generation graph persists a partial canonical output per
# completed module so the teacher sees each module appear in a live preview instead of
# only a step loader. Set to false to disable the per-node partial write + /preview
# endpoint and degrade cleanly to the step loader (no schema/realtime changes either way).
AUTHORING_LIVE_PREVIEW=true

# -- Algorithm catalog reduction (kill-switch) --------------------
# Reduce the forward-facing algorithm catalog shown in the teacher authoring form
# (and used by the suggester + intake validation). When true (default) the regresion
# family and the clustering challenger (DBSCAN) are hidden: ml_ds sees {Logistic
# Regression, Random Forest, K-Means}, business sees {Logistic Regression, K-Means}.
# Set to false to restore the full catalog byte-identically (env-only revert, no
# redeploy). Catalog entries are retained, so historical job replay is unaffected.
ALGORITHM_CATALOG_REDUCED=true

# -- ml_ds de-churn dataset signal (kill-switch, Issue #382) ------
# When true (default), a NON-retention ml_ds + clasificación case (fraud/default/approval)
# derives its binary target's SIGNAL from a DOMAIN driver instead of churn_rate, and the
# churn/SaaS template columns are stripped from the synthetic dataset. Set to false to ship
# the prior churn-coupled schema byte-identically (instant revert, no redeploy). churn/
# retention cases are unaffected either way.
MLDS_DECHURN_SIGNAL=true

# -- ml_ds economic-direction priors (kill-switch, Issue #506) ----
# When true (default), an ml_ds + clasificación case whose contract declares feature
# `expected_direction` hints ("positive"/"negative") couples its binary target to a SIGNED
# combination of those features, so the executed model's coefficients respect economic theory
# (e.g. law of demand: higher proposed fee -> lower acceptance) instead of an arbitrary positive
# sign. Set to false to ship the prior unsigned schema byte-identically (instant revert, no
# redeploy). No-op when no direction is declared or outside ml_ds + clasificación.
MLDS_DIRECTIONAL_PRIORS=true

# -- ml_ds outlier respects declared range (kill-switch) ----------
# When true (default), the EDA-outlier injection (Fix B-05) stays inside each feature's DECLARED
# [range_min, range_max] for ml_ds datasets, so no generated value exceeds its semantic bound
# (e.g. a credit_score declared [300, 850] never ships an impossible 1700; a percentage never
# exceeds 100). The injected point stays a detectable ~5σ outlier AND a valid value, matching the
# already-correct business path. Set to false to restore the legacy ml_ds ×2.0 cap byte-identically
# (instant revert, no redeploy). business is unaffected either way (it always capped at range_max).
MLDS_OUTLIER_RESPECT_RANGE=true

# -- Drop 100%-null dataset columns (kill-switch) -----------------
# When true (default), the `data_validator` node drops any column that is 100% NULL from the emitted
# dataset (rows + schema). A `type:"date"` column the deterministic generator cannot populate (e.g.
# `cancellation_request_date`) ships 100% null and shows as an all-red band in the M2 missingness
# heatmap + an all-"null" dataset column. The M3 notebook already excludes such a column (`isna>0.5`),
# so this is byte-identical in modelling/grounding — a cosmetic cleanup. A partially-null column (real
# missingness) is never dropped; the target is never dropped. Set to false to keep the empty column
# byte-identically (instant revert, no redeploy).
DATASET_DROP_EMPTY_COLUMNS=true

# -- ml_ds binary target coercion (kill-switch, Issue #350) -------
# When true (default), a deterministic sibling forces any non-int / non-classification target the
# LLM emits for an ml_ds + clasificación case to a binary int classification_target {0,1} BEFORE
# the schema chain, so the binary-only downstream never silently degrades (post-#348). Set to false
# to disable the coercion and restore the prior behavior byte-identically (instant revert, no
# redeploy). churn / already-binary cases are unaffected either way.
MLDS_BINARY_TARGET_COERCE=true

# -- business event-rate calibration (kill-switch, Issue #518) ----
# When true (default), a business + clasificación case calibrates its synthetic binary target's
# prevalence to the architect's declared target_event_rate (the SAME number Exhibit 2 prints), via
# the deterministic top-k argsort that preserves the driver->target order. Set to false to revert
# byte-identically (business rates nullified, target lands at ~0.50; instant revert, no redeploy).
# ml_ds + clasificación is unaffected either way.
BUSINESS_EVENT_RATE_CALIBRATION=true

# -- ml_ds clustering structure (kill-switch, Issue #452) --------
# When true (default), an ml_ds + clustering (K-Means) case gets a dedicated entity-level
# SEGMENTATION schema (interpretable segmentation features instead of the generic churn/SaaS
# panel) AND a deterministic helper rewrites the scalable numeric features into K∈{3,4}
# separable Gaussian blobs, so K-Means discovers genuine segments (silhouette ~0.45-0.70)
# instead of partitioning a unimodal cloud. Set to false to revert the clustering case to the
# generic schema + unimodal data byte-identically (instant revert, no redeploy). Other families
# and the business profile are unaffected (gate: profile==ml_ds AND family==clustering).
MLDS_CLUSTERING_STRUCTURE=true

# -- ml_ds clustering simplex centroids (kill-switch, k-coherence fix) --------
# Centroid geometry for the injected clustering blobs. When true (default), the K∈{3,4} blob
# centers are placed as a regular SIMPLEX (mutually-equidistant, randomly rotated into the feature
# space) so the notebook's data-driven k-selection (argmax_k silhouette — the cell the student
# runs) lands on the coordinated target_k (#467). The legacy per-feature permutation placement
# could leave the silhouette peaking at k=2/3 while M1/M4/M5 framed target_k=4 segments, so the
# student read "4 segmentos" but their notebook reported 2. Set to false to revert to the legacy
# permutation placement + _CLUSTERING_BLOB_SPREAD_FRAC (byte-identical to pre-fix; RED control for
# the new oracle). Only affects geometry when MLDS_CLUSTERING_STRUCTURE is also on.
MLDS_CLUSTERING_SIMPLEX_CENTERS=true

# -- ml_ds clustering executor (kill-switch, Issue #453) ---------
# When true (default), the ml_ds + clustering (K-Means) M3 notebook is EXECUTED in the same
# subprocess/AST-scrub/timeout path as classification (#239): real silhouette/n_clusters metrics
# are parsed into m3_metrics_summary and a NON-blocking silhouette-floor quality gate degrades
# cleanly (a low silhouette flags m3NotebookDegraded; a missing marker / degenerate clustering
# reprompts once then degrades). Set to false to generate but NOT execute the clustering notebook
# (prior behaviour, byte-identical; instant revert, no redeploy). Classification is unaffected.
MLDS_CLUSTERING_EXECUTOR=true

# -- ml_ds clustering K-Means notebook (kill-switch, Issue #454) ---------
# When true (default), an ml_ds + clustering case whose only algorithm is K-Means gets the
# K-Means-ONLY M3 notebook (elbow + silhouette-vs-k, fit, cluster profiling, PCA scatter; DBSCAN
# removed from executable code), dispatched per-variant and validated against the K-Means-only
# sentinel/API set. Set to false to revert to the mixed K-Means+DBSCAN prompt byte-identically
# (instant revert, no redeploy). DBSCAN/contrast replay jobs keep the mixed prompt either way.
MLDS_CLUSTERING_KMEANS_NOTEBOOK=true

# -- ml_ds clustering M1 segmentation anchor (kill-switch, Issue #455) ---------
# When true (default), an ml_ds + clustering case uses the dedicated clustering M1 prompts
# (architect/writer/questions): the dilemma is framed as a SEGMENTATION decision, the A/B/C
# options are segmentation strategies (not classifier thresholds), no business_cost_matrix /
# target_event_rate are emitted, and the segmentation pregunta_eje survives into the questions
# prompt. Set to false to revert to the generic M1 prompts + nulled pregunta_eje byte-identically
# (instant revert, no redeploy). Gate: profile==ml_ds AND family==clustering; clasificación /
# regresión / serie_temporal / business (incl. business+clustering) are unaffected.
MLDS_CLUSTERING_M1_ANCHOR=true

# -- ml_ds clustering M2 EDA (kill-switch, Issue #456) ---------
# Specialize the M2 EDA (narrative + 2 Socratic questions) for ml_ds + clustering: data-only,
# pre-model, target-free pedagogy (scale/distance -> StandardScaler, correlation -> PCA, cluster
# tendency, silhouette reading) instead of the generic, target-oriented EDA prompt. Set to false
# to revert to the generic EDA prompt byte-identically (instant revert, no redeploy). Gate:
# profile==ml_ds AND family==clustering — business+clustering stays on the generic prompt (#317).
MLDS_CLUSTERING_M2_EDA=true

# -- ml_ds clustering M3-content segmentation narrative (kill-switch, Issue #457) ---------
# When true (default), an ml_ds + clustering case uses the dedicated M3_CONTENT_PROMPT_CLUSTERING
# (K-Means segmentation: how k is chosen, qualitative silhouette reading, cluster->persona
# profiling, action per segment) instead of the generic M3_EXPERIMENT_PROMPT. Anti-fabrication is
# enforced at the prompt boundary (it forbids concrete metric values) because the notebook executor
# runs AFTER this node, so m3_metrics_summary is structurally absent here (#336 pattern); real numeric
# anchoring is a downstream M4/M5 follow-up. Set to false to revert to the generic prompt
# byte-identically (instant revert, no redeploy). Gate: profile==ml_ds AND family==clustering;
# clasificación / regresión / serie_temporal / business (incl. business+clustering) are unaffected.
MLDS_CLUSTERING_M3_CONTENT=true

# -- ml_ds clustering M3 conceptual questions (kill-switch, EPIC #458) ----------------------
# When true (default), an ml_ds + clustering case selects the dedicated segmentation-native M3
# conceptual-questions prompt (3-question arc: how the number of segments is chosen, segment
# validity/robustness, and segments -> the M1 strategic A/B/C decision) instead of the generic
# supervised-experiment prompt (fragile hypothesis / algorithmic bias / discard-before-deploy) that
# the #467 hint only reframed on top of contradictory examples. The #467 hint still appends to anchor
# target_k. The 3 conceptual questions stay non-redundant with the 2 output-grounded notebook
# questions (#489/#494: read YOUR silhouette / profile a segment from YOUR table). Anti-fabrication is
# enforced at the prompt boundary (no concrete silhouette value pre-execution). Set to false to revert
# to the generic experiment prompt + #467 hint byte-identically (instant revert, no redeploy). Gate:
# profile==ml_ds AND family==clustering; every other cohort is unaffected.
MLDS_CLUSTERING_M3_QUESTIONS=true

# -- ml_ds clustering dedicated M4 (Impacto) questions prompt (kill-switch, EPIC #458) ------
# When true (default), an ml_ds + clustering case generates its 3 M4 questions with the dedicated
# segmentation-native M4_QUESTIONS_PROMPT_CLUSTERING instead of the generic prompt (whose P2 frames a
# SUPERVISED model-ROI verdict and demands citing M4 metrics — incoherent for a K-Means segmentation
# with no predictive model and no projected uplift). The dedicated prompt asks about segment value,
# prioritization vs. intervention cost (USD), and segmentation production risk; the lens hint (#437)
# and the #467/#469 verdict hint still append to it. Set to false to revert to the generic prompt
# byte-identically (instant revert, no redeploy). Gate: profile==ml_ds AND family==clustering; every
# other cohort (incl. business+clustering) is unaffected.
MLDS_CLUSTERING_M4_QUESTIONS=true

# -- ml_ds clustering dedicated M5 final-memorándum questions prompt (kill-switch, EPIC #458) -
# When true (default), an ml_ds + clustering case generates its single M5 consigna with the dedicated
# segmentation-native M5_QUESTIONS_PROMPT_CLUSTERING instead of the generic prompt (which frames the
# memo around a SUPERVISED model decision — incoherent for a segmentation, where the executive decision
# is which segmentation strategy Opción A/B/C to adopt). The memo keeps the SHARED M5 contract verbatim
# (1 consigna, 100-160 words, 5 single-sentence paragraphs); only the subject is reframed. The #467
# verdict hint + the _apply_clustering_m5_verdict_coherence guarantee still apply. Set to false to
# revert byte-identically (instant revert, no redeploy). Gate: profile==ml_ds AND family==clustering;
# every other cohort (incl. business+clustering) is unaffected.
MLDS_CLUSTERING_M5_QUESTIONS=true

# -- ml_ds clustering decision coherence source of truth (kill-switch, Issue #467) ---------
# When true (default), an ml_ds + clustering case resolves a deterministic clustering_decision
# {target_k in {3,4}, recommended_option in {A,B,C}, silhouette_floor} ONCE at intake and propagates
# it across modules: the data layer (#452) honors target_k (exact blob count), the M1 architect
# frames option recommended_option as the recommended one ~= target_k segments, M3-questions/M4/M5
# are hinted to honor it, and a deterministic verdict guard reprompts-once-then-degrades M4/M5 so all
# modules recommend the SAME option. Kills the data-k != narrative-k, M4=C vs M5=B, and fabricated
# "silhouette > 0.55" incoherences (the real band floor is ~0.45). INDEPENDENT of
# MLDS_CLUSTERING_STRUCTURE. Set to false to revert byte-identically (no clustering_decision -> data
# falls back to K in {3,4} by schema hash, no prompt hints, no verdict guard; instant revert, no
# redeploy). Gate: profile==ml_ds AND family==clustering; every other cohort is unaffected.
MLDS_CLUSTERING_DECISION_COHERENCE=true

# -- ml_ds + clasificacion M1->M5 verdict coherence (kill-switch) ----------------------------
# When true (default), M1's recommended strategic option (P3 solucion_esperada, A/B/C) is propagated
# to the M5 final memo so the case does not contradict itself about the answer (the classification
# analog of the clustering #467 defect "M1->A/B while M4/M5->C"): a brace-free nudge makes P3 state
# its option parseably, the M5 memo prompt is hinted to honor that option, and a deterministic
# reprompt-once-then-degrade guard enforces it. "M1 leads" -- M1 still PICKS the option; M4 is out of
# scope (its 4.5 is a model-deploy verdict, not an A/B/C choice). Set to false to revert
# byte-identically (no M1 hint, no M5 hint, no guard; instant env-only revert, no redeploy). Gate:
# profile==ml_ds AND family==clasificacion; every other cohort is unaffected.
CLASSIFICATION_VERDICT_COHERENCE=true

# -- ml_ds clustering entity + population coherence (kill-switch, Issue #513) ----------------
# When true (default), an ml_ds + clustering case has the architect emit an entity_descriptor
# {singular, plural, snake_prefix} (via a brace-free M1 hint that also declares EXACTLY
# _MLDS_CLUSTERING_MAX_ROWS entities), and the deterministic data layer renames the dataset index to
# {snake_prefix}_id / {snake_prefix}_00001 so the CSV matches the M1 narrative (Opción A). Gated
# TOGETHER with MLDS_CLUSTERING_STRUCTURE (the N-rows premise) so the hint never narrates N over a
# structure-off (200-row) dataset. Set to false to revert byte-identically (no hint, descriptor not
# persisted -> data falls back to the #468 user_id; instant revert, no redeploy). Gate: profile==ml_ds
# AND family==clustering; every other cohort is unaffected.
MLDS_CLUSTERING_ENTITY_COHERENCE=true

# -- ml_ds clustering M4 value frame (kill-switch, Issue #469) ------------------------------
# When true (default), an ml_ds + clustering case on the NEUTRAL Impact-Lens path selects a dedicated
# M4 content + chart prompt: the first chart is value-BY-SEGMENT (not a fabricated payback / break-even
# "Mes N"), §4.1/§4.2 are reframed for an exploratory segmentation (no AUC example, no invented
# "uplift"), the M4 questions get a coherence hint, and the M4 content guard ALSO anchors any cited
# silhouette to the REAL executed m3_metrics_summary["silhouette"] (reprompt-once-then-degrade).
# INDEPENDENT of MLDS_CLUSTERING_DECISION_COHERENCE. Set to false to revert byte-identically (generic
# M4 prompts + no silhouette check; instant revert, no redeploy). Gate: profile==ml_ds AND
# family==clustering; every other cohort is unaffected.
MLDS_CLUSTERING_M4_VALUE_FRAME=true

# -- M3 output-grounded notebook questions (kill-switch, Issue #489) ------------------------
# When true (default), an ml_ds + clustering case whose M3 notebook EXECUTED
# (output_depth==visual_plus_notebook, not degraded, finite m3_metrics_summary["silhouette"]) runs a
# dedicated POST-executor node (m3_notebook_questions_generator, on GLM z-ai/glm-5.2 with Gemini
# fallback) that adds 2 questions (numero 4/5) making the student interpret THEIR real notebook output:
# Q4 reads the real silhouette / justifies k; Q5 profiles a segment -> business action tied to the M1
# dilemma. solucion_esperada is anchored to the REAL executed metrics; a silhouette grounding guard
# reprompts-once-then-omits a fabricated value. The 3 existing M3 questions + their #415 guard are
# untouched (separate node + separate state key, merged into m3Questions only at the canonical adapter).
# Requires OPENROUTER_API_KEY (GLM) + GEMINI_API_KEY (fallback); without the OpenRouter key the node
# degrades to Gemini cleanly. Set to false to skip the node -> byte-identical to the 3 questions
# (instant env-only revert, no redeploy). Gate: profile==ml_ds AND family==clustering AND executed
# notebook; every other cohort / depth is unaffected.
M3_NOTEBOOK_QUESTIONS=true

# -- ml_ds clustering M3 Q5 anchored to REAL per-cluster profiles (kill-switch, Issue #494) -------
# When true (default), the M3 metrics cell ALSO exports cluster_profiles (per-feature means per cluster)
# to m3_metrics_summary, and the m3_notebook_questions_generator node makes Q5 cite the REAL per-feature
# domination (format `feature_name = NN.NN`), guarded by a deterministic validator that
# reprompts-once-then-omits a fabricated mean / segment count. Closes the residual hallucination risk
# #489 left open (Q5 was qualitative, B4-b). Set to false to revert Q5 to B4-b (byte-identical question
# behavior to #489; the inert emission stays on; instant env-only revert, no redeploy). Gate:
# profile==ml_ds AND family==clustering AND profiles present; every other cohort is unaffected.
MLDS_CLUSTERING_NOTEBOOK_PROFILES=true

# -- ml_ds clasificación M3 output-grounded questions (kill-switch, Issue #493) -------------------
# When true (default), the SAME m3_notebook_questions_generator node ALSO serves ml_ds + clasificación
# single-model cases (lr_only / rf_only) whose notebook EXECUTED: Q4 reads the real AUC vs the
# DummyClassifier baseline + the confusion matrix (qualitative); Q5 reads the top driver feature +
# direction (odds ratios for LR / permutation importances for RF) and ties it to the cost matrix + the
# M1 dilemma. solucion_esperada is anchored to the REAL executed metrics, guarded by
# detect_unanchored_adjacent_metrics (AUC/F1) + detect_unselected_model_mentions (single-model leak),
# reprompt-once-then-omit. lr_rf_contrast is OUT OF SCOPE. The master switch M3_NOTEBOOK_QUESTIONS still
# gates the whole node; this is a GRANULAR revert of the classification branch only. Set to false ->
# the classification branch noops (byte-identical to the 3 questions), clustering intact (instant
# env-only revert, no redeploy). Gate: profile==ml_ds AND family==clasificacion AND variant lr/rf AND
# finite selected-model AUC; every other cohort / depth is unaffected.
M3_NOTEBOOK_QUESTIONS_CLASSIFICATION=true

# -- ml_ds clustering de-supervise data + notebook prose (kill-switch, Issue #466) ---------
# When true (default), for an ml_ds + clustering case: (a) a deterministic strip removes any leaked
# supervised target column (e.g. an LLM-hallucinated `dummy_target`, or a contract target_column
# injected by the gateless augmenter) from the schema BEFORE data generation, so the student CSV has
# NO target; and (b) the M3 notebook §2.1 "Detección asistida" prose drops the supervised "categoría a
# predecir" framing. Clustering is unsupervised. Set to false to revert byte-identically (schema keeps
# the leaked column + §2.1 stays supervised; instant revert, no redeploy). Gate: profile==ml_ds AND
# family==clustering; every other cohort is unaffected.
MLDS_CLUSTERING_NO_TARGET=true

# -- ml_ds de-template financial panel for cross-section (kill-switch, Issue #507) ------
# When true (default), a NON-retention ml_ds + clasificación cross-section case (household/entity
# survey: environmental valuation, scoring, approval) ALSO strips the company financial panel columns
# (period/revenue/costs/margin_pct) from the synthetic dataset, EXCEPT any the contract declares as a
# feature. Set to false to keep the financial base byte-identically (#382-only behavior; instant
# revert, no redeploy). churn/retention/business/other families are unaffected either way.
MLDS_DETEMPLATE_CROSS_SECTION=true

# -- ml_ds de-template SaaS template for WORKFORCE/HR attrition (kill-switch, sibling of #382/#507) ---
# `attrition` is a HARD retention token, so the #382 de-churn skipped employee-attrition / staff-turnover
# ml_ds + clasificación cases and they kept the customer SaaS template (customer_ltv/plan_tier/churn_rate…),
# incoherent for an HR dataset. When true (default), the #382 retention RED LINE is narrowed to genuine
# SaaS CUSTOMER churn: a retention-by-name target that is ALSO workforce attrition (high-precision HR
# tokens in the target/feature names) falls through to the de-churn path → domain (HR) driver + SaaS
# template stripped. Set to false to keep every retention target on the template byte-identically
# (#382/#507 behavior; instant env-only revert, no redeploy). Genuine customer churn is NEVER affected.
MLDS_DETEMPLATE_WORKFORCE=true

# -- ml_ds clustering deterministic EDA chart builder (kill-switch, Issue #466 Frente 2) ---------
# When true (default), an ml_ds + clustering case routes M2 charts through a deterministic, data-only,
# PRE-MODEL builder (3 charts: feature distributions -> motivates StandardScaler, correlation heatmap,
# 2D feature-pair scatter with NO cluster labels/centroids); the LLM only annotates. This kills the
# supervised "feature vs Target" regression chart the generic LLM-JSON path emits. Set to false to
# revert to the generic LLM-JSON path byte-identically (instant revert, no redeploy). A runtime builder
# failure degrades to an empty panel (NOT LLM-JSON) so the supervised chart can never reappear. Gate:
# profile==ml_ds AND family==clustering (the builder is profile-agnostic; business+clustering is #317).
MLDS_CLUSTERING_CHARTS=true

# -- ml_ds clustering M1 currency honesty (kill-switch, Issue #514) ---------
# When true (default), a brace-free node-level hint is appended to the case_architect + case_writer
# prompts for ml_ds + clustering, prohibiting absolute $ on the per-entity/per-segment behavior axes
# (e.g. "$135.000/mes", "$15M") the per-row dataset can't back; Exhibit 1 (company P&L, aggregate USD)
# stays; per-segment value is expressed qualitatively/relatively. Feature-agnostic (names no column).
# Prevention layer (the deterministic guard is the sibling Issue #515). Set to false to skip the append
# -> byte-identical (instant revert, no redeploy). Gate: profile==ml_ds AND family==clustering (STRICT).
MLDS_CLUSTERING_CURRENCY_HONESTY=true

# -- ml_ds clustering M1<->dataset coherence validator (kill-switch, Issue #515) ---------
# The deterministic GUARANTEE sibling of #513/#514. When true (default), a pure validator checks the
# M1 narrative against the deterministic dataset: a per-entity/per-segment USD figure exceeding the
# dataset's monetary scale ceiling (x3) triggers reprompt-once-then-DEGRADE in case_writer; entity/
# population contradictions are logger-only. Gate: profile==ml_ds AND family==clustering AND
# MLDS_CLUSTERING_STRUCTURE on. Best-effort (degrades/logs, never fails a job). Set to false to skip
# the guard -> byte-identical (instant revert, no redeploy). Every other cohort byte-identical either way.
MLDS_CLUSTERING_M1_COHERENCE_GUARD=true

# -- ml_ds clustering domain-adaptive segmentation columns (kill-switch, Issue #531) ---------
# When true (default), the architect's DOMAIN feature_columns (with the architect's range_min/range_max
# or a name/dtype heuristic) ARE the dataset's segmentation features, so the CSV is coherent with ANY
# case domain (educacion/salud/ambiental/manufactura) instead of always the generic e-commerce RFM.
# Falls back to the fixed RFM when there is no/insufficient contract. The duplicate-column/broken-range
# defect is fixed UNCONDITIONALLY (the augmenter is skipped on the clustering deterministic path), so
# false reverts to the CLEAN fixed-6-RFM baseline (what g07 shows), NOT the buggy duplicate path
# (instant revert, no redeploy). Gate: profile==ml_ds AND family==clustering.
MLDS_CLUSTERING_DOMAIN_COLUMNS=true

# -- USD-only currency backstop (kill-switch, Issue #377) ---------
# When true (default), a deterministic relabel forces any non-USD currency token next to a
# figure (€/£/EUR/COP/MXN/R$/…) to USD in the architect Exhibits/dilema + the downstream prose,
# so no foreign currency reaches the student. A conforming case ($/USD only) is byte-identical.
# Set to false to passthrough exactly (instant revert, no redeploy). The product is USD-only (#370).
CASE_USD_CURRENCY_ENFORCE=true

# -- LaTeX math delimiter strip (kill-switch, Issue #480) ---------
# When true (default), a deterministic, currency-safe strip removes inline LaTeX math delimiters
# ($k$, $k=2$, $5000.0 - 50.0$) from the architect prose + downstream narrative, because the
# case-viewer has no KaTeX/MathJax and the student would see the literal delimiter. A $-prefix
# figure ($8,000,000 USD / $64.8M) is never touched; the M3 notebook (Colab renders math) is
# excluded. A text without LaTeX is byte-identical. Set to false to passthrough exactly.
CASE_STRIP_LATEX_MATH=true

# -- M1 Exhibit <br> normalization (kill-switch, Issue #356) ------
# When true (default), the architect's M1 Exhibit tables (doc1_anexo_*) have any literal
# <br> row separators converted to real newlines at the case_architect return, so the
# persisted table renders as a GFM table instead of raw markdown. An exhibit without <br>
# is byte-identical. Set to false to passthrough exactly (instant revert, no redeploy).
M1_EXHIBIT_NORMALIZE=true

# -- M1 question option coherence (kill-switch) ------------------
# When true (default), the M1 discussion questions are checked so a `solucion_esperada`
# only recommends a strategic option that exists in the case (A/B/C, from dilema_brief) and
# that its own enunciado presents; case_questions reprompts once then degrades. Gated to the
# classification family (business + ml_ds); other cases are unaffected. Set to false to
# passthrough exactly (instant revert, no redeploy).
M1_OPTION_COHERENCE=true

# -- M2 EDA question coherence (kill-switch) ---------------------
# When true (default), each M2 EDA Socratic question is checked so its `chart_ref` exists in
# the chart manifest and the event rate cited in `solucion_esperada` matches its own
# `enunciado` (and the real dataset prevalence for ml_ds); eda_questions_generator reprompts
# once then degrades. Gated to the classification family (business + ml_ds); other cases are
# unaffected. Set to false to passthrough exactly (instant revert, no redeploy).
M2_QUESTION_COHERENCE=true

# -- M2 chart-id relabel (kill-switch, Issue #499) --------------
# When true (default), any internal snake_case chart id (e.g. feature_distributions) leaked into
# the student-visible M2 EDA question prose (titulo/enunciado/solucion_esperada) is rewritten to
# the chart's readable manifest title. Deterministic, family-agnostic, best-effort; the structured
# chart_ref field is never touched. Byte-identical for prose with no leaked id. Set to false to
# passthrough exactly (instant revert, no redeploy).
M2_CHART_ID_RELABEL=true

# -- M3 question coherence (kill-switch) ------------------------
# When true (default), each M3 socratic question is checked so its `m3_section_ref` exists in
# the section taxonomy for its profile (business -> 3.1-3.5; ml_ds -> exp.*) and single-model
# questions (lr_only / rf_only) do not name the unselected model; m3_questions_generator
# reprompts once then degrades. Gated to the classification family (business + ml_ds); other
# cases are unaffected. Set to false to passthrough exactly (instant revert, no redeploy).
M3_QUESTION_COHERENCE=true

# -- M4 question option coherence (kill-switch) -----------------
# When true (default), each M4 (Impacto) decision question is checked so its `solucion_esperada`
# only recommends an option that exists in the case (A/B/C) and that its own `enunciado`
# presents; m4_questions_generator reprompts once then degrades (preserving count + numero).
# Gated to the classification family (business + ml_ds); other cases are unaffected. Set to
# false to passthrough exactly (instant revert, no redeploy).
M4_QUESTION_COHERENCE=true

# -- M5 memorándum question coherence (kill-switch) -------------
# When true (default), the M5 memorándum is checked so it does not name the unselected model
# (ml_ds single-model), does not cite a model metric (AUC/F1/...) absent from the executed M3
# metrics (ml_ds), and does not recommend a strategic option (A/B/C) that does not exist in the
# case (both profiles); m5_questions_generator reprompts once then degrades. Gated to the
# classification family (business + ml_ds); other cases are unaffected. Set to false to
# passthrough exactly (instant revert, no redeploy).
M5_QUESTION_COHERENCE=true

# -- M2 missingness-map honest text (kill-switch, ml_ds + clasificación) --
# When true (default), the M2 "Mapa de valores faltantes" chart gets deterministic, honest text
# from the python builder describing the REAL missingness of the sample (and a centered empty-state
# annotation when there are 0 nulls), and the chart is excluded from LLM annotation so the LLM can
# no longer invent an MNAR pattern the de-churned ml_ds+clf dataset (#382) never has. Scoped to the
# classification python path; business/other-family/non-clf cases are unaffected. Set to false to
# restore the prior behavior byte-identically (empty builder text + LLM annotates; instant revert,
# no redeploy). The frontend colorbar fix applies regardless of this flag.
M2_MISSINGNESS_HONEST_TEXT=true

# -- M2 Mutual-Information model-ready feature filter (kill-switch, ml_ds + clasificación) --
# When true (default), the M2 "Top features por Mutual Information" chart excludes columns that
# inflate MI through high-cardinality discrete encoding: the temporal index `period` ("2023-01",
# always all-unique → MI≈H(Y) artifact), IDs, free-text and other high-cardinality categoricals,
# plus constants and >50%-null columns — mirroring the M3 notebook's modeled feature universe.
# Continuous numerics (financial base + the real driver) are kept (k-NN MI does not inflate with
# cardinality). Scoped to the classification python path; business/other-family/non-clf cases are
# unaffected. Set to false to restore the prior behavior byte-identically (all columns except the
# target enter the ranking; instant revert, no redeploy).
M2_MI_EXCLUDE_INDEX=true

# -- M2 classification chart honest text (kill-switch, ml_ds + clasificación) --
# When true (default), the M2 "Distribución de la variable objetivo" (class_distribution) and "Top
# features por Mutual Information" (mutual_info_top8) charts get deterministic, data-grounded text
# from the python builder: the exact class balance + the majority-baseline reading (Accuracy
# Paradox), and the real MI ranking top feature + the MI≠causation/leakage caveat. Both charts are
# excluded from LLM annotation, so the LLM (which never sees the data) can no longer write a caption
# that contradicts the chart. With M2_MISSINGNESS_HONEST_TEXT also on, all 3 charts are deterministic
# and the annotate-only LLM call is skipped entirely. Scoped to the classification python path;
# business/other-family/non-clf cases are unaffected. Set to false to restore the prior behavior
# byte-identically (empty builder text + LLM annotates the two charts; instant revert, no redeploy).
M2_CLASSIFICATION_CHART_HONEST_TEXT=true

# -- M6 Teaching Note per-module teacher guide (kill-switch) ------
# When true (default), Module 6 ("Solución Maestra") is a concise 3-section teacher guide: §1
# "Resumen para el Docente", §2 "Recorrido por Módulo" (assembled deterministically in Python —
# module set/numbering/labels correct by construction, mirroring getModuleConfig; the LLM only
# fills one short anchor per module), and §3 "Plan de Clase y Dónde se Traban". The 1.000-word §4
# "Análisis del Caso" (FCE + Benchmarks) is deleted. Set to false to restore the byte-identical
# previous behavior (legacy two-prompt note; instant revert, no redeploy).
TEACHING_NOTE_MODULE_GUIDE=true

# -- M4 deployment-recommendation de-dup backstop (kill-switch, ml_ds + clasificación) --
# The M4 impact narrative emits a single deployment recommendation (§4.5); the prompt fix removed
# the additive duplicate sections ("Recomendación de despliegue (un solo modelo)" / "Modelo
# recomendado para la decisión"). When true (default), m4_content_generator runs a pure detector
# over the generated narrative and emits a logger.warning if a residual second deployment heading
# slips through. LOGGER-ONLY: never reprompts, mutates, or fails a job. No-op for business and the
# non-classification families. Set to false to skip the detector entirely (no log, no cost;
# instant revert, no redeploy).
M4_DEPLOYMENT_DEDUP=true

# -- M4 chart sensitivity/tornado removal (kill-switch, both profiles) --
# M4 emits 2 financial charts (Payback + Comparativa A/B/C). The Sensitivity/Tornado chart was
# retired: orphan (no §4.x narrative / no M4 question), highest fabrication risk (ungrounded ±20%
# swings), redundant with the Payback chart. When true (default), m4_chart_generator uses the
# 2-chart prompts and runs a deterministic backstop that drops any residual sensitivity chart the
# LLM emits anyway. Set to false to restore the prior 3-chart behavior byte-identically (LEGACY
# prompts + backstop skipped; instant revert, no redeploy).
M4_CHART_DROP_SENSITIVITY=true

# -- M4 chart grounding (kill-switch, ml_ds+clf and business+clf) --
# Deterministic guard so the M4 financial charts never ship an unverified model metric (AUC/F1/recall
# anchored to the executed M3 metrics) or an invented "benchmark" figure. On a violation the node
# reprompts ONCE and then DROPS the still-offending chart (never fails the job, never shows false
# data). Set to false to disable the runtime guard (charts ship as the LLM produced them); the prompt
# hardening stays either way (instant env-only revert of the guard, no redeploy).
M4_CHART_GROUNDING=true

# -- M4 benchmark-fabrication guard (kill-switch, both profiles, ALL families) --
# The M4 prompts used to ORDER the LLM to fabricate figures when data was missing ("Valores estimados
# basados en benchmarks de {industria}"). The prompt fix (M4 narrative + generic chart prompts now degrade
# to QUALITATIVE; never invent benchmarks) is a one-way improvement and is NOT behind this switch. When
# true (default), m4_content_generator / m4_chart_generator also run a best-effort LOGGER-ONLY backstop
# that warns if a residual fabrication tell slips through (never reprompts, mutates, or fails a job). Set
# to false to skip the runtime backstop (no log, no cost); the prompt fix stays either way (instant
# env-only revert of the guard, no redeploy).
M4_FABRICATION_GUARD=true

# -- M4 decision-charts reframe (kill-switch, ml_ds + clasificación ONLY, NEUTRAL/lens-on path) --
# Reframes the ml_ds+clf M4 charts to be coherent + grounded: Gráfico 1 = the lens-aware investment
# case (LLM, anchored to the M4 narrative; no invented per-period cash schedule, no forced monetization
# of a non-financial lens); Gráfico 2 = the cost-of-errors economics built DETERMINISTICALLY in Python
# from the contract business_cost_matrix (fp/fn, USD) — zero fabrication, omitted when the case has no
# real asymmetric cost matrix (M4 then ships only Gráfico 1). Replaces the old prompt that ordered the
# LLM to invent an "A) Full deploy / B) Piloto / C) Heurístico" comparison. Set to false to keep the
# prior 2-chart LLM prompt byte-identically (instant env-only revert). ml_ds-only — business+clf,
# clustering, other families and the legacy 3-chart path are byte-identical regardless.
M4_CLASSIFICATION_DECISION_CHARTS=true

# -- M4 investment-chart dual y-axis (kill-switch, ml_ds + clasificación, NON-financial lens) --
# On the decision-charts reframe Gráfico 1, the deployment COST (always USD) and the projected VALUE in
# the lens unit (e.g. "240 estudiantes retenidos") used to share ONE y-axis; differing by orders of
# magnitude, the value bar rendered invisible. When true (default), m4_chart_generator appends a hint
# telling the LLM to put the non-monetary value on a SECONDARY y-axis (Plotly y2). The FINANCIAL lens is
# unaffected (both series in USD → the clean payback chart is byte-identical). Set to false to skip the
# hint → byte-identical single-axis behavior (instant env-only revert). No-op when the reframe is off,
# the lens is financial, or the cohort is not ml_ds+clasificación.
M4_INVESTMENT_DUAL_AXIS=true

# -- Impact Lens (kill-switch, Issue #437 / ADR 0003, ALL profiles/families) --
# M4's value frame (primary metric, §4.5 KPI rows, chart metrics, questions framing) is no longer
# hardcoded to ROI/Payback/NPV; it is an "impact lens" resolved ONCE (by _resolve_impact_lens) and
# consumed by the 3 M4 nodes. When true (default), m4_{content,questions,chart}_generator select the
# NEUTRAL (value-frame-agnostic) prompt twins and append the «MARCO DE VALOR» hint for the resolved lens
# (financial_roi reproduces ROI/Payback/NPV; clinical/operational/learning swap the KPI rows). Set to
# false to select the original FINANCIAL prompts and skip the hint → byte-identical to the pre-#437
# behavior (instant env-only revert, no redeploy). Costs always stay USD; the lens reframes only the
# value side. Charts apply the lens only on the 2-chart path (M4_CHART_DROP_SENSITIVITY=true).
# Fase 3 (#443): this SAME switch ALSO gates the M5 narrative (decision-matrix value-frame hint) and the
# M6 teaching-note synopsis (M4 module value noun) — reused so the M4/M5/M6 value frame reverts ATOMICALLY
# (off → all financial, byte-identical). financial_roi and the no-override path are byte-identical for
# M5/M6 even with the switch on (they parametrize in place, no NEUTRAL twins). Keep this aligned with
# IMPACT_LENS_ARCHITECT (both default on) — a mixed state can yield M1↔M4/M5/M6 incoherence.
IMPACT_LENS=true

# -- Impact Lens — architect side (kill-switch, Issue #437 / ADR 0003 Fase 2+3) --
# Separate from IMPACT_LENS (the M4/M5/M6 side) for granular revert; this gates ONLY the architect. When
# true (default), _assemble_architect_prompt appends a brace-free lens block so the architect emits
# `value_model` (its more-informed lens, the D-A hybrid signal that refines the intake lens) and frames
# the A/B/C option-superiority dimension by the lens's value metric (not always "mayor ROI"). Fase 3
# (#443): it ALSO gates the teacher-OVERRIDE hint appended in the case_architect node — when a teacher
# fixes the Impact Lens override, M1 frames + emits value_model by THAT lens (DD1 cross-module coherence).
# DD3: Exhibit 1 stays a USD P&L; only the value side is reframed. Set to false → the architect prompt is
# byte-identical to pre-#437 (the existing _MLDS_ARCHITECT_PROMPT_SHA256 still matches), the override hint
# is skipped, and the intake lens stands. Instant env-only revert, no redeploy.
IMPACT_LENS_ARCHITECT=true

# -- Teacher Impact Lens OVERRIDE (intake field, Issue #437 / ADR 0003 Fase 3) --
# NOT an env kill-switch: the teacher form's optional `impact_lens` field (one of financial_roi /
# operational_efficiency / clinical_outcomes / learning_outcomes, or absent = "Automático"). It is
# persisted to task_payload.impact_lens_override, read by state_input, and given the HIGHEST precedence in
# _resolve_impact_lens (above value_model and the industry default). Intake-only ⇒ resume-stable; an
# invalid value falls through (membership-checked, never coerced). It is automatically inert when the
# IMPACT_LENS / IMPACT_LENS_ARCHITECT switches are off (its consumers are gated). No env var to set.

# -- Raw-identifier leak guard (kill-switch, Issue #437 follow-up, ALL profiles/families) --
# sklearn ColumnTransformer feature names (num__col / cat__col / …) used to leak from the M3
# top_features into the M4/M5 narrative prose. The DETERMINISTIC fix (_strip_transformer_prefix inside
# build_computed_metrics_block) is always on. This switch gates ONLY the best-effort, LOGGER-ONLY
# backstop (detect_raw_identifier_leak) in m4_content_generator / m5_content_generator, which emits a
# structured logger.warning if a residual <word>__<x> token survives — it never reprompts, mutates, or
# fails a job. Set to false to skip the backstop (no log, no cost); the strip stays either way.
CASE_IDENTIFIER_LEAK_GUARD=true

# -- Supabase auth perimeter (Issue 23 + Issue 30) ----------------
# Required for JWT verification, activation flows and admin auth operations.
# Local auth/session dev uses `supabase start` at http://localhost:54321.
# Do not point DATABASE_URL at the Supabase local DB on 54322.
SUPABASE_URL=http://localhost:54321
SUPABASE_PROJECT_REF=local
# Obtain from `supabase status -o env` (SERVICE_ROLE_KEY). Backend-only, never browser.
SUPABASE_SERVICE_ROLE_KEY=

# Development-only JWT fallback for local verification. Do not use as the
# production verification path. Obtain from `supabase status -o env` (JWT_SECRET).
SUPABASE_JWT_SECRET=
MICROSOFT_TENANT_ID=
INVITE_TEACHER_TTL_HOURS=72
INVITE_STUDENT_TTL_HOURS=168

# -- Authoring job dispatch (ADR 0004 — Cloud Run cost split) -----
# inline (default): jobs run in-process via FastAPI BackgroundTasks. The ONLY correct
#   mode when the API runs with CPU always allocated (--no-cpu-throttling) or locally.
# cloud_tasks: intake/retry/regenerate enqueue to Cloud Tasks -> authoring-worker
#   (shared.worker_app), letting public-api run under request-based billing.
AUTHORING_DISPATCH=inline
# Producer coordinates — required only when AUTHORING_DISPATCH=cloud_tasks.
CLOUD_TASKS_PROJECT=
CLOUD_TASKS_LOCATION=
CLOUD_TASKS_QUEUE=adam-authoring-jobs
# Full URL of the worker internal endpoint:
#   https://<authoring-worker URL>/api/internal/tasks/authoring_step
CLOUD_TASKS_WORKER_URL=
# OIDC identity Cloud Tasks signs with (producer) AND the email the worker validates.
CLOUD_TASKS_SERVICE_ACCOUNT=
# OIDC audience for Cloud Tasks token validation (the authoring-worker Cloud Run URL).
# Required on both services when the split is active. Leave empty for local dev.
CLOUD_TASKS_AUDIENCE=
